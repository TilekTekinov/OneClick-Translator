{
  "manifest_version": 3,
  "name": "OneClick Translator",
  "version": "1.1",
  "description": "Open Google Translate page for selected text or specific page elements with one click.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "icons/icon128.png",
    "default_title": "Translate page content"
  },
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-current-site": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Translate content from chosen block on this site"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"]
    }
  ]
}
